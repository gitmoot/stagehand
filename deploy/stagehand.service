# Runner host (next to the data the shell stages use). Agent stages run in the
# sandboxd instance "stagehand" on hetzner2 via stagehand-hetzner2-tunnel.
[Unit]
Description=stagehand pipeline runner
After=network-online.target stagehand-hetzner2-tunnel.service stagehand-gateway-proxy.service
Wants=network-online.target stagehand-hetzner2-tunnel.service stagehand-gateway-proxy.service

[Service]
Type=simple
Environment=STAGEHAND_HOME=/var/lib/stagehand
# systemd sets no HOME for a root service without User=; shell stages inherit
# this one (tools such as omp, herdr and gh find their credentials through it).
Environment=HOME=/root
Environment=STAGEHAND_CONFIG=/etc/stagehand/config.yaml
# --trigger-addr: event intake (loopback only; needs events.secret_file in the config).
ExecStart=/usr/local/bin/stagehand serve --status-addr 127.0.0.1:8797 --trigger-addr 127.0.0.1:8798
Restart=on-failure
RestartSec=10
# Stop sends SIGTERM: running stages are stopped and their runs parked as
# interrupted. control-group also kills anything a crashed runner left.
KillMode=control-group
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
