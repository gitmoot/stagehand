# Fleet host: exposes the credential proxy on hetzner2 as 127.0.0.1:43294,
# where the stagehand run gateway forwards agents' model calls.
# Modeled on phobos-sandbox-hetzner2-tunnel.service.
[Unit]
Description=stagehand model tunnel: hetzner2 127.0.0.1:43294 -> this host 127.0.0.1:43295
Wants=network-online.target tailscaled.service stagehand-gateway-proxy.service
After=network-online.target tailscaled.service stagehand-gateway-proxy.service

[Service]
Type=simple
User=root
UMask=0077
# After a network drop, hetzner2's sshd keeps the dead session (its
# ClientAliveInterval is 0), and that session still holds 43294, so every
# reconnect fails with "remote port forwarding failed". Before connecting,
# end an sshd-session that holds this unit's own port: any holder is stale,
# because this unit's previous ssh process is gone. Other ports and other
# processes are never touched. Leading "-": a failure here (host down) must
# not block the retry loop.
ExecStartPre=-/usr/bin/ssh -T -o BatchMode=yes -o StrictHostKeyChecking=yes -o UpdateHostKeys=no -o IdentityAgent=none -o ControlMaster=no -o ControlPath=none -o ConnectTimeout=10 root@hetzner2 "for p in $$(ss -Hltnp 'sport = :43294' | grep sshd-session | grep -o 'pid=[0-9]*' | cut -d= -f2); do kill $$p; done"
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o StrictHostKeyChecking=yes -o UpdateHostKeys=no -o IdentityAgent=none -o ControlMaster=no -o ControlPath=none -o ExitOnForwardFailure=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -R 127.0.0.1:43294:127.0.0.1:43295 root@hetzner2
Restart=always
RestartSec=5
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
