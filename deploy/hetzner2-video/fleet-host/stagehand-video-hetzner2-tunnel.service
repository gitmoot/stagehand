# Fleet host: gives the hetzner2 video runner's model gateway its upstream
# without putting a model credential on hetzner2 (owner decision 2026-11-15,
# gitmoot/stagehand#28).
#   -R hetzner2 127.0.0.1:43299 -> 127.0.0.1:43295   stagehand-gateway-proxy here,
#                                                    which adds the gateway bearer
# Only root on hetzner2 can open 43299: its firewall rejects loopback for the
# CI runner and sandboxd jail uids. Modeled on stagehand-hetzner2-tunnel.service.
[Unit]
Description=stagehand video runner model route (hetzner2 43299 -> gateway-proxy 43295)
Wants=network-online.target tailscaled.service stagehand-gateway-proxy.service
After=network-online.target tailscaled.service stagehand-gateway-proxy.service

[Service]
Type=simple
User=root
UMask=0077
# After a network drop, hetzner2's sshd can briefly keep the dead session, and
# that session still holds 43299, so a reconnect fails with "remote port
# forwarding failed". Before connecting, end that session only if it is
# provably ours and dead. Leading "-": a failure here (host down) must not block
# the retry loop.
ExecStartPre=-/usr/local/bin/stagehand tunnel-clear-stale --ssh-host root@hetzner2 --remote-listen 127.0.0.1:43299
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o StrictHostKeyChecking=yes -o UpdateHostKeys=no -o IdentityAgent=none -o ControlMaster=no -o ControlPath=none -o ExitOnForwardFailure=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -R 127.0.0.1:43299:127.0.0.1:43295 root@hetzner2
Restart=always
RestartSec=5
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
